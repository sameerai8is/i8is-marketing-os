# Copy to .env.local. Never put real credentials in this tracked file.
MONGODB_URI=mongodb://127.0.0.1:27017/marketing-os
BUFFER_API_KEY=
# Set after selecting the I8IS organization in Buffer.
BUFFER_ORGANIZATION_ID=

# Server-side OpenAI credential; configure in Vercel for hosted deployments.
OPENAI_API_KEY=

# Google Workspace login. Generate a random AUTH_SECRET; never commit real secrets.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ADMIN_EMAIL=

# Canonical hosted URL; local AUTH_URL should be http://localhost:3000.
APP_URL=
AUTH_URL=
# Optional transactional invitation email. Sender must be verified in Resend.
RESEND_API_KEY=
INVITE_FROM_EMAIL=
# Optional model override for reviewed text drafts.
OPENAI_MODEL=gpt-4.1-mini

# Public HTTPS origin for signed Buffer image downloads.
PUBLISHING_MEDIA_ORIGIN=
# Random private token for authenticated Vercel publishing status checks.
CRON_SECRET=
